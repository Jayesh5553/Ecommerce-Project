{
  "name": "flipkart-ecommerce-fullstack",
  "version": "1.0.0",
  "description": "FullStack Flipkart Ecommerce Platform with Django REST Framework backend and React Vite frontend",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "py backend/manage.py runserver 127.0.0.1:8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
